{
  "name": "jevbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "deploy": "npm run check && wrangler deploy",
    "db:local": "wrangler d1 migrations apply jevbot --local",
    "db:remote": "wrangler d1 migrations apply jevbot --remote",
    "secrets": "node scripts/configure-secrets.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=24"
  }
}
